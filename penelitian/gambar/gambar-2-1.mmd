    D --> C
    E --> C
    C --> F
    F --> G
    G --> H

    classDef masalah fill:#fdecea,stroke:#c0392b,stroke-width:1px,color:#111
    classDef antara fill:#fff6e5,stroke:#d68910,stroke-width:1px,color:#111
